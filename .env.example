# Meeo Admin Dashboard Environment Configuration Example
# Copy this to .env.local for local development

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api/v1

# Firebase Web Push Configuration (Public Client Credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_MESUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_WEB_PUSH_CERTIFICATION=your_vapid_public_key

# Google OAuth Client ID (Public Client Identifier)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
